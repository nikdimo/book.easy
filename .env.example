# Database — direct Postgres URL (matches docker-compose.yml: user postgres, password postgres, db bookeasy).
# Optional: run `docker compose up -d` if you do not already have Postgres on port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookeasy?schema=public"

# Expo web preview. In production, set MOBILE_WEB_ORIGIN to the exact deployed
# mobile-web origin; comma-separate multiple origins when needed.
MOBILE_PREVIEW_URL="http://localhost:8081"
MOBILE_WEB_ORIGIN="http://localhost:8081"

# Auth.js — openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://lingerhomes.com
NEXT_PUBLIC_APP_NAME="Linger Homes"

# Location search and map tiles (geoapify.com)
# Keep the server key private. Use a separate browser-restricted key for map tiles.
GEOAPIFY_API_KEY=""
NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=""

# Google Maps Embed API + Street View Static API metadata (console.cloud.google.com)
# One key, restricted by API (not by HTTP referrer — it's called from both the server
# and the browser). Both APIs used here are free/unbilled. Leave unset to simply not
# show the Street View preview on the host listing location step.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Google Maps JavaScript API — interactive Street View picker for hosts only.
# Use a separate browser key restricted to Maps JavaScript API and website referrers
# such as https://lingerhomes.com/* and http://localhost:3000/*.
NEXT_PUBLIC_GOOGLE_MAPS_JAVASCRIPT_API_KEY=""

# Google Places API — address + business/POI search for the host listing location step
# (console.cloud.google.com). This one IS billed, though Google's $200/month credit
# should comfortably cover this app's actual listing-creation volume. Separate key from
# the one above and NOT prefixed NEXT_PUBLIC_ — it's only ever called server-side, so
# restrict it to just "Places API" with no Application restriction needed (it never
# ships to the browser). Leave unset to fall back to no address search at all.
GOOGLE_PLACES_API_KEY=""

# File uploads
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="10"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP for magic-link sign-in emails
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Linger Homes <hello@lingerhomes.com>"
SUPPORT_EMAIL="support@lingerhomes.com"

# Claude API (console.anthropic.com) — used to AI-translate fixed UI text for
# languages with useAiTranslation enabled in Admin > Settings > Languages
ANTHROPIC_API_KEY=""
# Pin this in production when upgrading models so translation behavior changes are intentional.
ANTHROPIC_TRANSLATION_MODEL="claude-sonnet-5"
# Optional Gemini fallback used when Anthropic is unavailable or out of quota.
GOOGLE_API_KEY=""
GEMINI_TRANSLATION_MODEL="gemini-2.5-flash"
# Requests per minute the sync will issue to Gemini. The default matches the free
# tier for gemini-2.5-flash; raise it on a paid plan to speed up large syncs.
GEMINI_REQUESTS_PER_MINUTE="5"
UI_TRANSLATION_SYNC_CONCURRENCY="3"
UI_TRANSLATION_REVIEW_CONCURRENCY="3"

# Optional fallback used by `npm run i18n:generate-reviewed:openai`.
OPENAI_API_KEY=""
OPENAI_TRANSLATION_MODEL="gpt-4.1-mini"

# Optional Expo push security token. Native Expo projectId is supplied by EAS config.
EXPO_ACCESS_TOKEN=""

# Google Analytics (tagmanager.google.com) — optional, for tracking with user consent
NEXT_PUBLIC_GA_ID=""
