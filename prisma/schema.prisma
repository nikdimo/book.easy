generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum SuggestionKind {
  PROPERTY_TYPE
  AMENITY
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuggestionScope {
  GLOBAL
  LISTING_ONLY
}

// Moderation is post-publication: publishing writes APPROVED with `needsReview`, an
// admin clears that flag, and safety problems go to SUSPENDED. There is deliberately no
// PENDING_REVIEW/REJECTED pair here — reintroducing either would turn this back into a
// pre-publication queue that no code path implements.
enum ListingStatus {
  DRAFT
  APPROVED
  UNPUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ListingAvailabilityMode {
  OPEN
  CLOSED
}

enum ListingPaymentMethod {
  CASH_AT_PROPERTY
  BANK_TRANSFER_LOCAL_SEPA
  BANK_TRANSFER_INTERNATIONAL
  PAYPAL
  REVOLUT
  WISE
  BITCOIN
  HOST_SECURE_CARD_LINK
  OTHER
  ARRANGE_DIRECTLY
}

/// DEPRECATED (V1 deposit model). A host-set deposit policy that allowed exactly one
/// purpose. Superseded by the independent `advancePayment*` / `damageDeposit*` columns
/// on Listing. Retained unwritten so the additive migration stays reversible and so
/// historical rows remain inspectable; nothing reads it at runtime.
enum ListingDepositPolicy {
  NONE
  FIXED
  PERCENTAGE
}

/// DEPRECATED (V1 deposit model). The single-purpose discriminator that made "advance
/// payment" and "refundable damage deposit" mutually exclusive. The live model gives
/// each its own columns, so a host can require neither, either, or both.
enum ListingDepositPurpose {
  ADVANCE_PAYMENT
  DAMAGE_SECURITY
}

/// When a host expects one of their deposit policies to be paid. Shared by both the
/// advance payment and the damage deposit, which choose their timing independently.
enum ListingDepositDueTiming {
  AFTER_ACCEPTANCE
  DAYS_BEFORE_CHECK_IN
  AT_CHECK_IN
}

/// How one deposit policy expresses its amount: a flat sum in the listing currency, or
/// a share of the booking total. Each policy picks its own.
enum ListingDepositAmountType {
  FIXED
  PERCENTAGE
}

/// Manual, declarative payment tracking. These values never assert that Linger
/// Homes processed a transaction.
enum BookingPaymentStatus {
  UNTRACKED
  NOT_REQUIRED
  AWAITING_PAYMENT
  PAYMENT_REPORTED
  PAYMENT_CONFIRMED
}

/// Whether an accepted booking still needs the host to send private payment
/// instructions. This is workflow state only: it never claims that money moved.
enum BookingPaymentInstructionsStatus {
  NOT_DECIDED
  PENDING
  SENT
  NOT_NEEDED
}

/// Manual tracking for an advance payment or refundable security deposit. A
/// separate return state keeps a received security deposit distinct from one that
/// a host says has been returned.
enum BookingDepositStatus {
  UNTRACKED
  NOT_REQUIRED
  AWAITING_DEPOSIT
  DEPOSIT_REPORTED
  DEPOSIT_CONFIRMED
  RETURN_REPORTED
  RETURN_CONFIRMED
  RETAINED
}

/// Manual refund progress created by a cancellation policy. A due refund is an
/// obligation, while reported and confirmed remain participant statements.
enum BookingRefundStatus {
  NOT_REQUIRED
  AWAITING_REFUND
  REFUND_REPORTED
  REFUND_CONFIRMED
}

enum BookingPaymentRequestType {
  ADVANCE_PAYMENT
  ACCOMMODATION_BALANCE
  DAMAGE_DEPOSIT
}

enum BookingPaymentRequestStatus {
  DRAFT
  SENT
  CANCELLED
  SETTLED
}

enum BookingPaymentTrack {
  ADVANCE_PAYMENT
  ACCOMMODATION_BALANCE
  DAMAGE_DEPOSIT
  ACCOMMODATION_REFUND
  DAMAGE_DEPOSIT_RETURN
  DAMAGE_DEPOSIT_RETENTION
}

enum BookingPaymentReminderKind {
  DUE_SOON
  DUE_DATE
  OVERDUE
  RETURN_DUE
}

enum MessageKind {
  CHAT
  PAYMENT_INSTRUCTIONS
}

enum PromotionType {
  PERCENT_DISCOUNT
  FREE_CLEANING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  CANCELLED_BY_ADMIN
  COMPLETED
}

enum BookingEmailKind {
  GUEST_REQUEST_RECEIVED
  HOST_NEW_REQUEST
  HOST_REQUEST_REMINDER
  GUEST_CONFIRMED
  GUEST_REJECTED
  GUEST_EXPIRED
  GUEST_CANCELLED
  HOST_CANCELLED_BY_GUEST
}

enum BookingEmailDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum BlockType {
  MANUAL_BLOCK
  BOOKING_HOLD
  /**
   * Mirrored from an external calendar (Airbnb, Booking.com, …) by the iCal sync.
   * Owned by the feed that created it: a re-sync deletes and recreates only these,
   * so a host's own manual blocks are never touched by a remote calendar.
   */
  EXTERNAL_SYNC
}

enum CalendarFeedStatus {
  PENDING
  OK
  ERROR
}

enum ListingMediaType {
  IMAGE
  VIDEO
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ConversationKind {
  INQUIRY
  BOOKING
}

enum ConversationStatus {
  OPEN
  FROZEN
  CLOSED
}

enum ConversationParticipantRole {
  MEMBER
  SUPPORT
}

enum BookingTimelineEventType {
  REQUESTED
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  CANCELLED_BY_ADMIN
  COMPLETED
}

enum DamageReportStatus {
  REPORTED
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum SafetyCaseType {
  REPORT
  CLAIM
}

enum SafetyCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_INFORMATION
  RESOLVED
  REJECTED
}

enum SafetyCasePriority {
  NORMAL
  URGENT
}

enum SafetyCaseTargetType {
  USER
  HOST
  LISTING
  BOOKING
  MESSAGE
}

enum ReviewDirection {
  GUEST_TO_HOST
  HOST_TO_GUEST
}

enum ReviewStatus {
  PENDING_ADMIN
  APPROVED
  REJECTED
  HIDDEN
}

enum ReviewRatingCategory {
  OVERALL
  ACCURACY
  CHECK_IN
  CLEANLINESS
  COMMUNICATION
  LOCATION
  VALUE
  HOUSE_RULES
}

enum ReviewReminderStage {
  INVITATION
  DAY_3
  DAY_7
  HOURS_48
  HOURS_24
  OTHER_PARTY_SUBMITTED
}

enum ClaimKind {
  EXPENSE
  DAMAGE
  REFUND
}

enum ClaimResponseStatus {
  AWAITING_ADMIN
  AWAITING_RECIPIENT
  ACCEPTED
  COUNTERED
  REJECTED
  ESCALATED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  CHAT_MESSAGE
  CASE_SUBMITTED
  CASE_UPDATED
  SUPPORT_MESSAGE
  REVIEW_INVITATION
  REVIEW_SUBMITTED
  REVIEW_PUBLISHED
  REVIEW_REJECTED
  SYSTEM
}

enum CommunicationChannel {
  EMAIL
  PUSH
}

enum MarketingAudience {
  GUEST
  HOST
}

enum MarketingPreferenceStatus {
  NOT_SUBSCRIBED
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
  SUPPRESSED
}

enum MarketingConsentAction {
  REQUESTED
  CONFIRMED
  WITHDRAWN
  SUPPRESSED
}

enum MarketingSuppressionReason {
  UNSUBSCRIBE
  COMPLAINT
  HARD_BOUNCE
  MANUAL
  PRIVACY_OBJECTION
}

enum MarketingTokenPurpose {
  CONFIRM_EMAIL
  UNSUBSCRIBE_EMAIL
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum MarketingDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id        String               @id @default(cuid())
  userId    String?
  name      String
  email     String
  category  String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ─── User & Profile ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  image           String?
  name            String
  role            UserRole  @default(USER)
  isHost          Boolean   @default(false)
  isActive        Boolean   @default(true)
  emailVerified   DateTime?
  /// Language for system email. Set when the visitor picks a language in the
  /// switcher; null means English. Emails are sent by background jobs hours after
  /// the fact, where the request-scoped locale cookie no longer exists — so the
  /// choice has to live on the account, not in `getLocale()`.
  locale          String?
  /// Display currency for browsing, so the choice follows the account to another
  /// device. Purely presentational: prices are authored, charged and settled in the
  /// listing's official currency regardless of what this says. Null means the
  /// visitor has never chosen, and detection applies.
  displayCurrency String?
  /// When this account was erased under the right to erasure, and the marker that the
  /// row is a husk rather than a person.
  ///
  /// Erasure anonymizes in place instead of deleting the row. Four foreign keys onto
  /// `User` are `ON DELETE RESTRICT` — `Booking.guestId`, `Listing.hostId`,
  /// `Property.ownerId`, `Suggestion.hostId` — and the records behind them have to
  /// outlive the account for tax, audit and dispute purposes. Nulling those columns
  /// would push `null` through every read of a booking's guest or a listing's host;
  /// pointing them all at one shared tombstone would merge distinct people into a
  /// single identity. Keeping one meaningless row per erased account preserves the
  /// history, keeps each record distinguishable from the next, and lets
  /// `booking.guest.name` keep resolving — to "Deleted user", the same string the
  /// messaging UI already shows for a null sender.
  ///
  /// Everything identifying is gone by the time this is set: `email` becomes an
  /// unroutable `deleted-<id>@deleted.invalid` placeholder (which also frees the real
  /// address for a fresh signup), `name` becomes "Deleted user", and the avatar,
  /// locale, currency and profile are removed. `isActive` goes false in the same write,
  /// which is what stops the row being signed into again.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile                      Profile?
  properties                   Property[]
  listings                     Listing[]
  bookings                     Booking[]
  auditLogs                    AuditLog[]
  accounts                     Account[]
  sessions                     Session[]
  suggestions                  Suggestion[]                     @relation("SuggestionHost")
  reviewedSuggestions          Suggestion[]                     @relation("SuggestionReviewer")
  listingDrafts                ListingDraft[]
  listingReports               ListingReport[]                  @relation("ListingReportReporter")
  reviewedListingReports       ListingReport[]                  @relation("ListingReportReviewer")
  favorites                    Favorite[]
  userConsents                 UserConsent[]
  notifications                Notification[]
  pushTokens                   PushToken[]
  conversationMemberships      ConversationParticipant[]
  sentMessages                 Message[]                        @relation("MessageSender")
  messageEmailDeliveries       MessageEmailDelivery[]           @relation("MessageEmailRecipient")
  bookingTimelineEvents        BookingTimelineEvent[]           @relation("BookingTimelineActor")
  bookingPaymentStatusEvents   BookingPaymentStatusEvent[]      @relation("BookingPaymentStatusActor")
  bookingPaymentPrivateRecords BookingPaymentPrivateRecord[]    @relation("BookingPaymentPrivateRecordReporter")
  bookingPaymentReminders      BookingPaymentReminderDelivery[] @relation("BookingPaymentReminderRecipient")
  damageReports                DamageReport[]                   @relation("DamageReporter")
  startedConversations         Conversation[]                   @relation("ConversationStarter")
  inquiryConversations         Conversation[]                   @relation("ConversationInquiryGuest")
  submittedSafetyCases         SafetyCase[]                     @relation("SafetyCaseReporter")
  reportedSafetyCases          SafetyCase[]                     @relation("SafetyCaseReportedUser")
  assignedSafetyCases          SafetyCase[]                     @relation("SafetyCaseAssignedAdmin")
  safetyCaseUpdates            SafetyCaseUpdate[]               @relation("SafetyCaseUpdateAuthor")
  authoredReviews              Review[]                         @relation("ReviewAuthor")
  receivedReviews              Review[]                         @relation("ReviewSubject")
  moderatedReviews             Review[]                         @relation("ReviewModerator")
  reviewInvitations            ReviewInvitation[]
  reviewAdminReads             ReviewAdminRead[]
  communicationPreference      CommunicationPreference?
  marketingContact             MarketingContact?
  contactMessages              ContactMessage[]
  deletionTokens               AccountDeletionToken[]
  facebookDestinations         HostFacebookDestination[]        @relation("HostFacebookDestination")
  promotionPreference          HostPromotionPreference?         @relation("HostPromotionPreference")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

/// Confirmation link for self-service account deletion. Deliberately separate from
/// `VerificationToken` (Auth.js): that table is consumed by the sign-in callback, so a
/// token stored there could be redeemed as a login. These are single-purpose and
/// short-lived — the only thing a leaked one can do is delete the account it belongs to.
model AccountDeletionToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ─── Auth.js (Google + magic link) ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  bio             String?
  avatarUrl       String?
  hostBio         String?
  hostDisplayName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Property & Listing ─────────────────────────────────────────────────────────

/**
 * Admin-manageable property types (e.g. "Detached House", "Row House"). Used to be a
 * Prisma enum, but that required a code migration + deploy every time a new type was
 * needed. Now a table so admins can approve host-suggested types at runtime (see
 * Suggestion below). `value` keeps the old enum's UPPER_SNAKE_CASE codes so existing
 * data/URLs/filters didn't need to change.
 */
model PropertyType {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  /**
   * Curated Lucide icon key, editable by admins in Settings.
   */
  icon        String   @default("Building2")
  /**
   * Short guest-facing explanation shown when a property type is hovered or focused.
   */
  description String   @default("A distinct type of accommodation available for guests to book.")
  /**
   * false = not offered in pickers/filters going forward, but still valid for any
   * property already using it (e.g. a "this listing only" suggestion approval).
   */
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  properties Property[]

  @@index([isActive])
}

model Property {
  id                  String       @id @default(cuid())
  ownerId             String
  name                String
  propertyType        String
  propertyTypeInfo    PropertyType @relation(fields: [propertyType], references: [value])
  address             String
  city                String
  area                String?
  country             String
  postalCode          String?
  latitude            Float?
  longitude           Float?
  locationSource      String?
  geocodingProvider   String?
  geocodingPlaceId    String?
  geocodingConfidence Float?
  /**
   * The exact Street View angle a host picked for this property (compass heading in
   * degrees, camera pitch, and the specific panorama id) — saved so guests see the
   * same curated view the host confirmed, rather than Google's default direction for
   * whatever panorama happens to be nearest. Null until a host actually saves one;
   * the guest-facing page falls back to no Street View at all rather than guessing.
   */
  streetViewHeading   Float?
  streetViewPitch     Float?
  streetViewPanoId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  listings Listing[]

  @@index([ownerId])
  @@index([city])
  @@index([propertyType])
}

model Listing {
  id                             String                   @id @default(cuid())
  propertyId                     String
  hostId                         String
  title                          String
  slug                           String                   @unique
  description                    String
  /**
   * What the guest exclusively books. Kept separate from Property.propertyType:
   * a private room can be inside a house, apartment, villa, or hotel.
   */
  spaceType                      ListingSpaceType         @default(ENTIRE_PLACE)
  status                         ListingStatus            @default(DRAFT)
  maxGuests                      Int
  bedrooms                       Int
  bathrooms                      Int
  beds                           Int
  /**
   * Wall-clock house rules ("15:00"), not instants — a check-in time is whatever the
   * clock on the wall says when the guest arrives, so storing it as DateTime would
   * attach a timezone that has no meaning here and shifts under the server's. Null
   * means the host is flexible and will agree arrival with the guest.
   */
  checkInTime                    String?
  checkOutTime                   String?
  /**
   * Structured house rules the guest agrees to when they book.
   * Every policy is nullable and NULL means "the host has not answered" — deliberately
   * distinct from an explicit NOT_ALLOWED. Defaulting these to a refusal would tell
   * guests that thousands of listings ban smoking, pets and parties on the strength of
   * a migration nobody's host ever ran. The public page prints only the answered ones,
   * exactly the way it already treats a null `checkInTime`.
   * The multi-choice enums exist because a boolean cannot express the two policies
   * hosts most often actually have: smoking outdoors only, and pets on request.
   */
  petPolicy                      ListingPetPolicy?
  smokingPolicy                  ListingSmokingPolicy?
  eventPolicy                    ListingEventPolicy?
  /**
   * NONE is an explicit "no quiet hours"; SET means both times below are present.
   * NULL is unanswered, the same as every policy above.
   */
  quietHoursPolicy               ListingQuietHoursPolicy?
  /**
   * Wall-clock "HH:MM", same convention and reasoning as checkInTime. Both set or
   * both NULL, and 22:00–08:00 crosses midnight legitimately, so there is no
   * start-before-end rule to enforce.
   */
  quietHoursStart                String?
  quietHoursEnd                  String?
  /**
   * The host's own rules, in their own words. Guest-facing copy, so it gets the same
   * treatment as `description`: stored exactly as written, flagged for re-review on
   * edit, and never overwritten with a machine translation.
   */
  additionalRules                String?                  @db.Text
  /**
   * When the host last saved the House rules section.
   * The completion marker the editor needs. Every field this section edits already has
   * a value the moment a listing exists, so "has values" cannot distinguish a host who
   * reviewed the page from one who never opened it — only a recorded visit can.
   */
  houseRulesReviewedAt           DateTime?
  /**
   * Public method names only. Never account details, handles, links, card data, or
   * payment instructions. An empty array with a null reviewed timestamp means this
   * host has not answered; ARRANGE_DIRECTLY is the explicit reviewed alternative.
   */
  acceptedPaymentMethods         ListingPaymentMethod[]   @default([])
  paymentMethodOther             String?
  paymentMethodsReviewedAt       DateTime?
  /**
   * Private, reusable host-authored instructions. Never expose this field through a
   * public listing or booking DTO; it only prefills the host's post-acceptance message.
   */
  paymentInstructionTemplates    Json?
  /**
   * DEPRECATED (V1 deposit model): one policy with a `purpose` discriminator, so a host
   * could ask for an advance payment or a damage deposit but never both.
   * The additive migration `..._independent_deposit_policies` copied these into the
   * `advancePayment*` / `damageDeposit*` columns below, which are now the only columns
   * read or written. These are kept frozen — not dropped — so the migration is
   * reversible and so an operator can still see what a listing said before the split.
   */
  depositPolicy                  ListingDepositPolicy     @default(NONE)
  depositPurpose                 ListingDepositPurpose?
  depositValue                   Decimal?                 @db.Decimal(14, 3)
  depositCurrency                String?
  depositDueTiming               ListingDepositDueTiming  @default(AFTER_ACCEPTANCE)
  depositDueDaysBeforeCheckIn    Int?
  /**
   * Present only when a DAMAGE_SECURITY deposit is refundable.
   */
  depositReturnDaysAfterCheckout Int?
  depositPolicyReviewedAt        DateTime?

  /**
   * The two independent deposit policies, public terms only. Neither carries a
   * destination detail, payment link, account identifier, or any money handled by
   * Linger Homes.
   * An advance payment counts toward the booking price; a damage deposit is additional
   * refundable security. They are separate columns rather than one policy with a flag
   * precisely so a host can require neither, either, or both, and so the two can never
   * be added together by accident.
   */
  advancePaymentEnabled                Boolean                   @default(false)
  advancePaymentType                   ListingDepositAmountType?
  advancePaymentValue                  Decimal?                  @db.Decimal(14, 3)
  advancePaymentDueTiming              ListingDepositDueTiming   @default(AFTER_ACCEPTANCE)
  advancePaymentDueDaysBeforeCheckIn   Int?
  damageDepositEnabled                 Boolean                   @default(false)
  damageDepositType                    ListingDepositAmountType?
  damageDepositValue                   Decimal?                  @db.Decimal(14, 3)
  damageDepositDueTiming               ListingDepositDueTiming   @default(AFTER_ACCEPTANCE)
  damageDepositDueDaysBeforeCheckIn    Int?
  /**
   * How long after checkout the host says they expect to return the deposit. Optional:
   * null means the host stated no period, not that the deposit is never returned.
   */
  damageDepositReturnDaysAfterCheckout Int?
  /**
   * The listing's own currency at the time the policies were saved. Both policies share
   * it — a listing quotes one currency — and it is taken from the pricing rule on the
   * server, never from client input.
   */
  depositPoliciesCurrency              String?
  /**
   * Null means the host has never deliberately answered the deposit question. That is a
   * different fact from having answered "neither", and guests are told which it is.
   */
  depositPoliciesReviewedAt            DateTime?
  /// Exact host-authored free-cancellation window. Null reviewedAt means the host has
  /// never answered; no default policy is invented for existing listings.
  freeCancellationDaysBeforeCheckIn    Int?
  cancellationPolicyReviewedAt         DateTime?
  moderationNote                       String?
  /**
   * True whenever the live content was created/edited since an admin last looked at
   * it — drives the admin "Pending Review" queue independently of `status`, since
   * listings are published immediately rather than gated behind approval.
   */
  needsReview                          Boolean                   @default(false)
  approvedAt                           DateTime?
  publishedAt                          DateTime?
  createdAt                            DateTime                  @default(now())
  updatedAt                            DateTime                  @updatedAt
  /**
   * OPEN keeps the traditional "available unless blocked" calendar. CLOSED means
   * only explicit availability windows can be booked. The default preserves every
   * listing created before selected-date hosting existed.
   */
  availabilityMode                     ListingAvailabilityMode   @default(OPEN)

  /**
   * Time-decayed demand signal (views + heavily-weighted bookings) recomputed by a
   * scheduled job — see lib/services/popularity.service.ts. Denormalised onto the
   * listing so the home page can order by it with a plain indexed query instead of
   * aggregating the event tables on every request. 0 means "no signal yet", which is
   * what gates the public "Popular homes" section from appearing at all.
   */
  popularityScore     Float     @default(0)
  popularityUpdatedAt DateTime?

  /**
   * Secret path segment of this listing's public iCal export — /api/calendar/<token>.ics.
   * The token *is* the credential: anyone holding it can read the listing's booked and
   * blocked dates (dates only, never guest identity), which is exactly what Airbnb and
   * Booking.com need and no more. Null until the host first opens the export, so
   * listings that never sync expose no feed at all, and rotatable from the calendar
   * screen when a host wants to cut an old subscriber off.
   */
  calendarFeedToken String? @unique

  property            Property                    @relation(fields: [propertyId], references: [id])
  host                User                        @relation(fields: [hostId], references: [id])
  images              ListingImage[]
  rooms               ListingRoom[]
  amenities           ListingAmenity[]
  pricingRule         PricingRule?
  datePrices          ListingDatePrice[]
  availabilityBlocks  AvailabilityBlock[]
  availabilityWindows ListingAvailabilityWindow[]
  calendarFeeds       ListingCalendarFeed[]
  bookings            Booking[]
  suggestions         Suggestion[]
  reports             ListingReport[]
  safetyCases         SafetyCase[]
  favorites           Favorite[]
  views               ListingView[]
  conversations       Conversation[]
  reviews             Review[]
  promotions          ListingPromotion[]

  @@index([hostId])
  @@index([status])
  @@index([slug])
  @@index([status, popularityScore])
  /**
   * Guest search filters on the pet policy directly now that it is a column rather
   * than an amenity join.
   */
  @@index([petPolicy])
}

/**
 * Pets need three answers, not two: "on request" is a real and common policy, and
 * collapsing it into either boolean tells the guest something the host did not say.
 */
enum ListingPetPolicy {
  ALLOWED
  NOT_ALLOWED
  ASK_HOST
}

/**
 * Outdoors-only is the single most common real smoking rule, and it is neither
 * "allowed" nor "not allowed".
 */
enum ListingSmokingPolicy {
  NOT_ALLOWED
  OUTDOORS_ONLY
  ALLOWED
}

enum ListingEventPolicy {
  ALLOWED
  NOT_ALLOWED
}

/**
 * Whether quiet hours apply at all, kept separate from the two times so that "the
 * host says there are none" and "the host has not answered" stay different facts.
 */
enum ListingQuietHoursPolicy {
  NONE
  SET
}

enum ListingSpaceType {
  ENTIRE_PLACE
  PRIVATE_ROOM
  SHARED_ROOM
  HOTEL_ROOM
}

/**
 * One row per visitor per listing per day — the raw signal behind popularityScore.
 * Deduped by (listingId, visitorKey, viewedOn) so a guest refreshing a page twenty
 * times counts once, which is what keeps "popular" from meaning "was already on the
 * home page". `visitorKey` is a salted hash of IP + user agent, never the raw values,
 * so no identifying data is stored; rows older than the scoring window are pruned by
 * the recompute job.
 */
model ListingView {
  id         String   @id @default(cuid())
  listingId  String
  visitorKey String
  viewedOn   DateTime @db.Date
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, visitorKey, viewedOn])
  @@index([listingId, viewedOn])
  @@index([viewedOn])
}

/**
 * A new listing's form state, autosaved on field blur before it satisfies the strict
 * validation a real Listing/Property row requires (title length, required fields,
 * etc.) — so it can hold partial/incomplete data without needing those columns to be
 * nullable. Submitting for review validates this data in full, creates the real
 * Property/Listing/PricingRule rows from it, and deletes this row. Never surfaced
 * publicly — purely a host-side "resume where I left off" mechanism.
 */
model ListingDraft {
  id        String   @id @default(cuid())
  hostId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

/**
 * A managed upload whose owning row is gone and whose file still has to be unlinked.
 * The queue exists because a file and a database row cannot be changed atomically. The
 * row is written in the *same transaction* as the deletion that orphaned the file, so a
 * crash between the commit and the unlink loses the file's bytes, never the knowledge
 * that they need removing — the sweep picks it up on the next run.
 * `url` is unique, which makes enqueueing idempotent: the same file queued twice is one
 * row, and processing it twice is a no-op the second time.
 */
model PendingUploadDeletion {
  id          String    @id @default(cuid())
  /// Always a server-generated `/uploads/...` path — remote and unsafe values are
  /// rejected before they ever reach this table.
  url         String    @unique
  /// What orphaned it ("listing-draft", "account-deletion", …). Diagnostics only; never
  /// shown to a user.
  reason      String
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model ListingImage {
  id           String           @id @default(cuid())
  listingId    String
  url          String
  mediaType    ListingMediaType @default(IMAGE)
  /// Equirectangular 2:1 image rendered as an interactive 360-degree panorama.
  /// Kept separate from mediaType because it is still an image for covers, counts,
  /// search cards, metadata, and every non-interactive fallback.
  isPanorama   Boolean          @default(false)
  alt          String?
  /**
   * Listing-level sequence: the order a guest sees in the gallery, and the order the
   * editor's All photos view shows. Independent of `roomOrder`.
   */
  displayOrder Int              @default(0)
  isPrimary    Boolean          @default(false)
  /**
   * The space this photo belongs to, or null for Other / Unassigned. Photos are never
   * required to have one — a host uploads first and organises later — and deleting a
   * room nulls this rather than taking the photos down with it.
   */
  roomId       String?
  /**
   * Sequence within `room`, kept apart from `displayOrder` so reordering a room's
   * photo tour cannot silently rewrite the listing's gallery order.
   */
  roomOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  listing Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room    ListingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([roomId])
}

// ─── Rooms and spaces ───────────────────────────────────────────────────────────

/**
 * A group of room types ("Interior", "Outdoor"), owned by admins rather than by code so
 * the taxonomy can grow from Settings without a deploy — the same arrangement
 * AmenityCategory has, and reconciled onto production by the same kind of release
 * snapshot.
 */
model RoomTypeCategory {
  id        String   @id @default(cuid())
  /**
   * Stable slug used by the release snapshot and by `rooms.categories.<key>`.
   */
  key       String   @unique
  /**
   * English label, and the source text every translation is measured against.
   */
  name      String   @unique
  icon      String?
  /**
   * Admin-defined display order, ascending, in every room picker.
   */
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  roomTypes    RoomType[]
  translations RoomTypeCategoryTranslation[]

  @@index([isActive])
}

/**
 * One kind of space a property can have — "Bedroom", "Terrace", "Sauna".
 */
model RoomType {
  id           String   @id @default(cuid())
  name         String   @unique
  /**
   * Stable slug: survives renames, and matches `rooms.types.<key>` in the UI string
   * catalog so a catalog row and its reviewed translation stay linked.
   */
  key          String   @unique
  categoryId   String
  icon         String?
  sortOrder    Int      @default(0)
  /**
   * Whether one property can hold several of these. A repeatable type numbers its
   * instances ("Bedroom 1", "Bedroom 2"); a singular one stays unnumbered, because
   * "Kitchen 1" reads as a mistake on a property that only has the one.
   */
  isRepeatable Boolean  @default(true)
  /**
   * Offered up front in a listing's rooms rail before the host has created anything, as
   * a greyed row holding a zero. It becomes a real ListingRoom the moment a photo lands
   * on it — which is what saves a host from facing an empty rail and having to invent
   * the vocabulary of their own flat.
   */
  isStandard   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  category     RoomTypeCategory      @relation(fields: [categoryId], references: [id])
  rooms        ListingRoom[]
  translations RoomTypeTranslation[]

  @@index([isActive])
  @@index([categoryId])
}

/**
 * Admin-authored room type label per language, resolved ahead of the reviewed source
 * catalog — same resolution order, and same reasoning, as AmenityTranslation.
 */
model RoomTypeTranslation {
  id               String   @id @default(cuid())
  roomTypeId       String
  locale           String
  label            String
  /**
   * Typed by an admin rather than filled by the AI pass, so a re-fill leaves it.
   */
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([roomTypeId, locale])
  @@index([locale])
}

model RoomTypeCategoryTranslation {
  id               String   @id @default(cuid())
  categoryId       String
  locale           String
  label            String
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  category RoomTypeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language         @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

/**
 * One space inside one listing — the "Bedroom 2" a host drags photos onto.
 * The structured type stays in `roomTypeId` so a room can be grouped, translated and
 * counted whatever the host calls it; `displayName` is an optional override ("Master
 * bedroom") that never becomes the only way to tell what kind of room this is.
 */
model ListingRoom {
  id          String   @id @default(cuid())
  listingId   String
  roomTypeId  String
  /**
   * 1-based position among this listing's rooms of the same type, and what the "2" in
   * "Bedroom 2" comes from. Always 1 for a type that is not repeatable.
   */
  ordinal     Int      @default(1)
  displayName String?
  /**
   * Host-defined order of the photo tour, ascending.
   */
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType RoomType       @relation(fields: [roomTypeId], references: [id])
  images   ListingImage[]

  /**
   * One "Bedroom 2" per listing. Also what lets the first-open seeding insert with
   * skipDuplicates instead of racing itself when two requests arrive together.
   */
  @@unique([listingId, roomTypeId, ordinal])
  @@index([listingId])
  @@index([roomTypeId])
}

// ─── Amenities ──────────────────────────────────────────────────────────────────

/**
 * A group of amenities ("Kitchen", "Safety"), owned by admins rather than by code so
 * a new group can be created, renamed, reordered and translated from Settings without
 * a deploy.
 */
model AmenityCategory {
  id        String   @id @default(cuid())
  /**
   * Stable slug used by the release snapshot and by `amenities.categories.<key>`.
   */
  key       String   @unique
  /**
   * English label, and the source text every translation is measured against.
   */
  name      String   @unique
  icon      String?
  /**
   * Admin-defined display order, ascending, for every amenity picker.
   */
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  amenities    Amenity[]
  translations AmenityCategoryTranslation[]

  @@index([isActive])
}

model Amenity {
  id         String   @id @default(cuid())
  name       String   @unique
  /**
   * Stable slug: survives renames, and matches `amenities.items.<key>` in the UI
   * string catalog so a catalog row and its reviewed translation stay linked.
   */
  key        String   @unique
  categoryId String
  icon       String?
  /**
   * Admin-defined display order within the category, ascending.
   */
  sortOrder  Int      @default(0)
  /**
   * false = not offered in the general amenity picker, but still valid for any
   * listing already using it (e.g. a "this listing only" suggestion approval).
   */
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  category     AmenityCategory      @relation(fields: [categoryId], references: [id])
  listings     ListingAmenity[]
  aliases      AmenityAlias[]
  translations AmenityTranslation[]

  @@index([isActive])
  @@index([categoryId])
}

/**
 * Admin-authored amenity label per language.
 * Deliberately separate from UiTranslation: those keys come from the AST scan over
 * source literals, so a row an admin creates at runtime could never appear there.
 * Resolution order is this table, then the reviewed source-literal catalog in
 * lib/i18n/amenity-labels.ts, then the English name.
 */
model AmenityTranslation {
  id               String   @id @default(cuid())
  amenityId        String
  locale           String
  label            String
  /**
   * Typed by an admin rather than filled by the AI pass, so a re-fill leaves it.
   */
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([amenityId, locale])
  @@index([locale])
}

model AmenityCategoryTranslation {
  id               String   @id @default(cuid())
  categoryId       String
  locale           String
  label            String
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  category AmenityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language        @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

/**
 * Provider-specific labels that resolve to one canonical Linger Homes amenity.
 */
model AmenityAlias {
  id             String   @id @default(cuid())
  provider       String
  providerName   String
  normalizedName String
  amenityId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([provider, normalizedName])
  @@index([amenityId])
}

/**
 * Host-submitted "you're missing an option" requests for a property type or amenity
 * not in the current catalog. An admin can edit the label, then approve it either
 * GLOBAL (added to the catalog for all future listings) or LISTING_ONLY (usable just
 * on the listing that requested it, without polluting the catalog for everyone else).
 */
model Suggestion {
  id           String           @id @default(cuid())
  kind         SuggestionKind
  label        String
  note         String?
  status       SuggestionStatus @default(PENDING)
  scope        SuggestionScope?
  listingId    String?
  hostId       String
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime         @default(now())

  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  host       User     @relation("SuggestionHost", fields: [hostId], references: [id])
  reviewedBy User?    @relation("SuggestionReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([hostId])
}

/**
 * A visitor-submitted flag on a listing (e.g. "photos don't match", "price is wrong"),
 * with an optional free-text message. `reporterId` is nullable since reporting doesn't
 * require an account. An admin reviews it from /admin/reports and either dismisses it
 * or removes the listing (suspends it), mirroring Suggestion's review pattern.
 */
model ListingReport {
  id           String       @id @default(cuid())
  listingId    String
  reporterId   String?
  message      String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("ListingReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("ListingReportReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([listingId])
}

/**
 * A user saving a listing for later (the heart/"Save" toggle on cards and the listing
 * page). One row per user+listing so the saved state is the same everywhere it's shown
 * and survives across devices/sessions, and shows up in /account/favorites.
 */
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

// ─── Pricing ────────────────────────────────────────────────────────────────────

model PricingRule {
  id                String   @id @default(cuid())
  listingId         String   @unique
  baseNightlyRate   Decimal  @db.Decimal(14, 3)
  cleaningFee       Decimal  @default(0) @db.Decimal(14, 3)
  serviceFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  currency          String   @default("EUR")
  minNights         Int      @default(1)
  maxNights         Int      @default(365)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/**
 * A host-funded public offer. A listing may have several active offers. At quote
 * time, date-specific offers take precedence and the highest qualifying
 * minimum-night threshold wins.
 */
model ListingPromotion {
  id               String        @id @default(cuid())
  listingId        String
  type             PromotionType
  discountPercent  Int           @default(0)
  minimumNights    Int?
  freeCleaning     Boolean       @default(false)
  roundToWholeUnit Boolean       @default(true)
  startDate        DateTime?     @db.Date
  endDate          DateTime?     @db.Date
  disabledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([listingId, disabledAt])
  @@index([listingId, startDate, endDate])
}

model ListingDatePrice {
  id          String   @id @default(cuid())
  listingId   String
  date        DateTime @db.Date
  nightlyRate Decimal  @db.Decimal(14, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
}

// ─── Availability ───────────────────────────────────────────────────────────────

model AvailabilityBlock {
  id        String    @id @default(cuid())
  listingId String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  blockType BlockType
  bookingId String?
  /**
   * Set only on EXTERNAL_SYNC rows — which imported calendar put this block here.
   * Cascades, so disconnecting a feed frees every date it was holding.
   */
  feedId    String?
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listing Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  feed    ListingCalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
  @@index([bookingId])
  @@index([feedId])
}

/**
 * An external iCal calendar mirrored into this listing — the import half of channel
 * sync, the export half being Listing.calendarFeedToken.
 * Deliberately one row per remote calendar rather than a single "airbnbUrl" column on
 * Listing: a host with the same place on Airbnb, Booking.com and Vrbo needs all three,
 * and each has to report its own freshness. `lastStatus` and `lastError` are kept so a
 * feed that has started failing (URL rotated, listing deleted upstream) is visible on
 * the calendar screen instead of silently going stale — the dates it already blocked
 * stay blocked until the host removes the feed, which is the safe direction to fail.
 */
model ListingCalendarFeed {
  id                String             @id @default(cuid())
  listingId         String
  /**
   * Host-facing label ("Airbnb", "Booking.com"). Free text — the platform is not
   * something we can reliably detect from an opaque .ics URL.
   */
  name              String
  url               String
  lastSyncedAt      DateTime?
  lastStatus        CalendarFeedStatus @default(PENDING)
  lastError         String?
  /**
   * Counters from the last successful sync, shown to the host as proof it worked.
   */
  lastEventCount    Int                @default(0)
  lastBlockedNights Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  listing Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  blocks  AvailabilityBlock[]

  @@unique([listingId, url])
  @@index([listingId])
  @@index([lastSyncedAt])
}

/**
 * Bookable windows for listings whose calendar is CLOSED by default. Stored with an
 * exclusive end date, matching bookings and AvailabilityBlock ranges.
 */
model ListingAvailabilityWindow {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

// ─── Booking ────────────────────────────────────────────────────────────────────

model Booking {
  id                                 String                           @id @default(cuid())
  reference                          String                           @unique @default(cuid())
  listingId                          String
  guestId                            String
  checkIn                            DateTime                         @db.Date
  checkOut                           DateTime                         @db.Date
  /// The capacity number every pricing, `maxGuests` and search rule already works
  /// from: adults + children. Infants and pets are deliberately not in it — a cot and
  /// a dog do not consume a bed — so this stays exactly the figure it has always been.
  guestCount                         Int
  /// The party the guest actually chose, kept beside `guestCount` rather than folded
  /// into it. Adults and children are the two that add up to `guestCount`; infants and
  /// pets are informational counts the host needs for cots, cleaning and access, and
  /// are never summed into capacity.
  ///
  /// All four are nullable together, and they are nullable for one reason: a booking
  /// taken before these columns existed has no record of the party, and NULL says
  /// exactly that. A zero would claim the guest brought no infant and no pet — a
  /// statement nobody ever asked them to make. The migration performs no backfill for
  /// the same reason. `adults` is the discriminator: every booking written since these
  /// columns exist carries at least one adult, so `adults == null` means "not recorded".
  adults                             Int?
  children                           Int?
  infants                            Int?
  pets                               Int?
  currency                           String                           @default("EUR")
  nightlyRate                        Decimal                          @db.Decimal(14, 3)
  cleaningFee                        Decimal                          @default(0) @db.Decimal(14, 3)
  serviceFee                         Decimal                          @default(0) @db.Decimal(14, 3)
  totalPrice                         Decimal                          @db.Decimal(14, 3)
  originalTotal                      Decimal?                         @db.Decimal(14, 3)
  discountAmount                     Decimal                          @default(0) @db.Decimal(14, 3)
  promotionId                        String?
  promotionType                      PromotionType?
  priceBreakdown                     Json?
  priceBreakdownVersion              Int?
  /// What the guest was browsing in when they booked, plus the rate used to show it.
  /// Frozen at confirmation so the confirmation page and email keep showing the same
  /// approximate figure the guest saw, instead of silently re-converting at today's
  /// rate every time the page is opened. `currency` above remains the official,
  /// payable amount; these three are a record of a display, never of an obligation.
  /// Null when the guest was already browsing in the official currency.
  displayCurrency                    String?
  displayRate                        Decimal?                         @db.Decimal(20, 10)
  displayTotal                       Decimal?                         @db.Decimal(14, 3)
  /// Language selected by the guest at booking time. Confirmation pages and
  /// transactional email use this snapshot, not a later account preference.
  guestLocale                        String?
  numberOfNights                     Int
  status                             BookingStatus                    @default(PENDING)
  responseDueAt                      DateTime                         @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '24 hours')"))
  respondedAt                        DateTime?
  hostReminderSentAt                 DateTime?
  /// The listing's house rules exactly as they stood when this guest accepted them,
  /// plus the moment they did. Built on the server from the listing row — never from
  /// anything the client posted — and never rewritten afterwards: a host editing their
  /// rules changes what future guests agree to, not what this one already did. Null on
  /// every booking taken before acceptance was recorded, which is why it is nullable
  /// rather than defaulted. Same JSON-snapshot pattern as `priceBreakdown` above.
  houseRulesSnapshot                 Json?
  houseRulesAcceptedAt               DateTime?
  /// The listing's accepted-payment-method answer as it stood when this request was
  /// created. Built server-side from the listing row, never from request input. Null
  /// only for bookings created before this snapshot was introduced.
  paymentMethodsSnapshot             Json?
  /// The method the guest chose from the frozen list above. Null only for legacy or
  /// unanswered listings; a host cannot silently replace it during acceptance.
  selectedPaymentMethod              ListingPaymentMethod?
  /// The listing's deposit answer exactly as it stood when this request was created.
  /// It stays null on bookings created before manual payment tracking was introduced.
  ///
  /// Written as a V1 object before the deposit split and as a V2 object since; readers
  /// go through `parseDepositPoliciesSnapshot`, which understands both. Historical rows
  /// are never rewritten: what this guest agreed to stays exactly as they agreed it.
  depositPolicySnapshot              Json?
  /// The listing's cancellation terms frozen when the guest sends the request.
  cancellationPolicySnapshot         Json?
  /// DEPRECATED (V1): the single frozen deposit amount, whichever purpose it had.
  /// Superseded by the two independent amounts below and frozen in place.
  depositAmount                      Decimal?                         @db.Decimal(14, 3)
  /// The two frozen amounts, computed independently from the V2 snapshot in the listing
  /// currency. Deliberately never summed: the advance payment is part of `totalPrice`,
  /// while the damage deposit is additional security money on top of it. Neither is a
  /// charge, authorization, payout, or transfer processed by Linger Homes.
  advancePaymentAmount               Decimal?                         @db.Decimal(14, 3)
  damageDepositAmount                Decimal?                         @db.Decimal(14, 3)
  acceptedAt                         DateTime?
  cancelledAt                        DateTime?
  /// Progress on the booking price as a whole. The advance payment below is a part of
  /// this sum, not a separate debt, and is tracked separately because a host confirms
  /// receiving it at a different moment.
  paymentStatus                      BookingPaymentStatus             @default(UNTRACKED)
  paymentInstructionsStatus          BookingPaymentInstructionsStatus @default(NOT_DECIDED)
  paymentInstructionsSentAt          DateTime?
  paymentInstructionsDueAt           DateTime?                        @db.Date
  /// The structured payment details this guest was actually sent, frozen at send time.
  ///
  /// Written server-side from the host's reviewed input — never read back from the
  /// listing's reusable templates — so a host who later edits or deletes a template
  /// cannot change what a guest was already told to pay. Only structured (V2) sends
  /// write here: a free-text send leaves it null and the private conversation message
  /// remains the whole record, which is what keeps legacy bookings rendering as before.
  ///
  /// Private financial data. It belongs to the two booking participants and appears in
  /// no public listing DTO, notification preview, email body, audit entry, or log line.
  paymentInstructionsSnapshot        Json?
  /// DEPRECATED (V1): the single deposit track, shared by whichever purpose the listing
  /// had. The migration copied it into whichever of the two tracks below its frozen
  /// snapshot names, and nothing writes it again.
  depositStatus                      BookingDepositStatus             @default(UNTRACKED)
  /// The two independent manual tracks. A booking with both policies has both running
  /// at once, which is the whole reason they are separate columns: "the guest sent the
  /// damage deposit" must never imply anything about the advance payment.
  advancePaymentStatus               BookingPaymentStatus             @default(UNTRACKED)
  damageDepositStatus                BookingDepositStatus             @default(UNTRACKED)
  accommodationRefundAmount          Decimal?                         @db.Decimal(14, 3)
  accommodationRefundStatus          BookingRefundStatus              @default(NOT_REQUIRED)
  /// Frozen explanation of the refund amount and any maximum advance-payment amount
  /// the policy permitted the host to retain. It is an obligation calculation, never
  /// a claim that a refund or retention occurred.
  cancellationSettlementSnapshot     Json?
  paymentStatusUpdatedAt             DateTime?
  depositStatusUpdatedAt             DateTime?
  advancePaymentStatusUpdatedAt      DateTime?
  damageDepositStatusUpdatedAt       DateTime?
  accommodationRefundStatusUpdatedAt DateTime?
  guestNote                          String?
  hostNote                           String?
  cancellationReason                 String?
  createdAt                          DateTime                         @default(now())
  updatedAt                          DateTime                         @updatedAt

  listing                   Listing                          @relation(fields: [listingId], references: [id])
  guest                     User                             @relation(fields: [guestId], references: [id])
  promotion                 ListingPromotion?                @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  availabilityBlocks        AvailabilityBlock[]
  conversation              Conversation?
  safetyCases               SafetyCase[]
  reviews                   Review[]
  reviewInvitations         ReviewInvitation[]
  emailDeliveries           BookingEmailDelivery[]
  timelineEvents            BookingTimelineEvent[]
  paymentStatusEvents       BookingPaymentStatusEvent[]
  paymentRequests           BookingPaymentRequest[]
  paymentPrivateRecords     BookingPaymentPrivateRecord[]
  paymentReminderDeliveries BookingPaymentReminderDelivery[]
  damageReports             DamageReport[]

  @@index([listingId, status])
  @@index([guestId])
  @@index([status, responseDueAt])
  @@index([promotionId])
  @@index([listingId, checkIn, checkOut])
  @@index([status, paymentInstructionsStatus])
}

model BookingEmailDelivery {
  id          String                     @id @default(cuid())
  bookingId   String
  kind        BookingEmailKind
  status      BookingEmailDeliveryStatus @default(QUEUED)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([status, availableAt])
  @@index([bookingId, status])
}

// ─── Notifications & booking chat ─────────────────────────────────────────────

/**
 * Durable in-app notification. Push delivery is an additional transport for this
 * record, not the source of truth, so unread state survives across devices.
 */
model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  body            String
  route           String?
  data            Json?
  messageId       String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  pushAttempts    Int              @default(0)
  pushAvailableAt DateTime         @default(now())
  pushLockedAt    DateTime?
  pushSentAt      DateTime?
  pushLastError   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([userId, messageId])
  @@index([pushSentAt, pushAvailableAt])
}

/**
 * One device can rotate Expo push tokens over time. Tokens are unique globally and
 * reassigned to the currently authenticated user when a device changes account.
 */
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * The first release creates one conversation per booking. Keeping listingId explicit
 * makes future pre-booking inquiry conversations possible without changing Message.
 */
model Conversation {
  id                 String             @id @default(cuid())
  bookingId          String?            @unique
  listingId          String
  kind               ConversationKind   @default(BOOKING)
  status             ConversationStatus @default(OPEN)
  startedById        String?
  inquiryGuestId     String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  supportJoinedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  booking       Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing       Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startedBy     User?                     @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: SetNull)
  inquiryGuest  User?                     @relation("ConversationInquiryGuest", fields: [inquiryGuestId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  safetyCases   SafetyCase[]
  damageReports DamageReport[]

  @@unique([listingId, inquiryGuestId])
  @@index([listingId])
  @@index([kind, status])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           ConversationParticipantRole @default(MEMBER)
  unreadCount    Int                         @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime                    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id             String      @id @default(cuid())
  clientId       String?     @unique
  conversationId String
  senderId       String?
  body           String      @db.Text
  kind           MessageKind @default(CHAT)
  /// Locale chosen by the sender when this message was written. It lets the
  /// recipient see an honest "Google translated from …" disclosure when their
  /// reading language differs, without guessing from the text itself.
  sourceLocale   String      @default("en")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?                  @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  safetyCases     SafetyCase[]
  emailDeliveries MessageEmailDelivery[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageEmailDelivery {
  id          String                     @id @default(cuid())
  messageId   String
  recipientId String
  status      BookingEmailDeliveryStatus @default(QUEUED)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation("MessageEmailRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@index([status, availableAt])
  @@index([recipientId, status])
}

model BookingTimelineEvent {
  id             String                   @id @default(cuid())
  bookingId      String
  type           BookingTimelineEventType
  actorId        String?
  idempotencyKey String                   @unique
  data           Json?
  createdAt      DateTime                 @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

/**
 * Append-only manual-status audit trail. There is intentionally no note or free-text
 * payload here: payment instructions and personal financial details must never be
 * copied into a ledger owned by Linger Homes.
 */
model BookingPaymentStatusEvent {
  id                        String                @id @default(cuid())
  bookingId                 String
  actorId                   String?
  /// The exact actor-labelled action (for example GUEST_REPORT_DAMAGE_DEPOSIT_SENT).
  /// Status values alone cannot reveal which side changed on this event.
  eventType                 String
  paymentStatus             BookingPaymentStatus
  /// DEPRECATED (V1): the shared deposit track. Still written on every event so the
  /// column stays non-null and legible, but `damageDepositStatus` below is the value a
  /// reader should trust once both policies can exist at once.
  depositStatus             BookingDepositStatus
  /// The two independent tracks as they stood immediately after this event. Null only
  /// on events recorded before the deposit split, which had no per-policy state to
  /// report — a real distinction, and why these are nullable rather than defaulted.
  advancePaymentStatus      BookingPaymentStatus?
  damageDepositStatus       BookingDepositStatus?
  accommodationRefundStatus BookingRefundStatus?
  createdAt                 DateTime              @default(now())

  booking       Booking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor         User?                        @relation("BookingPaymentStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  privateRecord BookingPaymentPrivateRecord?

  @@index([bookingId, createdAt])
  @@index([actorId])
}

/// One booking-specific, host-reviewed request. Structured coordinates are frozen on
/// this row only after review; reusable listing templates are never sent automatically.
model BookingPaymentRequest {
  id                   String                      @id @default(cuid())
  bookingId            String
  type                 BookingPaymentRequestType
  amount               Decimal                     @db.Decimal(14, 3)
  currency             String
  dueAt                DateTime                    @db.Date
  status               BookingPaymentRequestStatus @default(DRAFT)
  method               ListingPaymentMethod?
  otherLabel           String?
  instructionsSnapshot Json?
  reviewedAt           DateTime?
  sentAt               DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  booking        Booking                          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  privateRecords BookingPaymentPrivateRecord[]
  reminders      BookingPaymentReminderDelivery[]

  @@unique([bookingId, type])
  @@index([status, dueAt])
}

/// Participant-private transaction metadata. The immutable event ledger contains only
/// statuses; reference, note and retention reason live here and are GDPR-redacted.
model BookingPaymentPrivateRecord {
  id              String              @id @default(cuid())
  bookingId       String
  requestId       String?
  eventId         String              @unique
  track           BookingPaymentTrack
  reporterId      String?
  amount          Decimal             @db.Decimal(14, 3)
  currency        String
  transactionDate DateTime            @db.Date
  reference       String?
  note            String?             @db.Text
  retainedReason  String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  booking  Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  request  BookingPaymentRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  event    BookingPaymentStatusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporter User?                     @relation("BookingPaymentPrivateRecordReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([bookingId, track, createdAt])
  @@index([requestId])
  @@index([reporterId])
}

/// Delivery deduplication only. Reminder state itself is always derived from the due
/// date and live settlement status; this table never becomes another payment status.
model BookingPaymentReminderDelivery {
  id            String                     @id @default(cuid())
  bookingId     String
  requestId     String?
  recipientId   String
  obligationKey String
  kind          BookingPaymentReminderKind
  dueAt         DateTime                   @db.Date
  sentAt        DateTime                   @default(now())

  booking   Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  request   BookingPaymentRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient User                   @relation("BookingPaymentReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Postgres truncates identifiers at 63 bytes, so the name this index was created
  // under in 20260828230000 lost its `_key` suffix. Naming it explicitly keeps the
  // datamodel matching what a fresh `migrate deploy` actually builds, instead of
  // leaving every `migrate diff` reporting a rename that nothing needs.
  @@unique([obligationKey, kind, recipientId], map: "BookingPaymentReminderDelivery_obligationKey_kind_recipientId_k")
  @@index([bookingId, sentAt])
  @@index([requestId])
}

model DamageReport {
