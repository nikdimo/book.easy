generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum SuggestionKind {
  PROPERTY_TYPE
  AMENITY
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuggestionScope {
  GLOBAL
  LISTING_ONLY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  UNPUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ListingAvailabilityMode {
  OPEN
  CLOSED
}

enum PromotionType {
  PERCENT_DISCOUNT
  FREE_CLEANING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  CANCELLED_BY_ADMIN
  COMPLETED
}

enum BookingEmailKind {
  GUEST_REQUEST_RECEIVED
  HOST_NEW_REQUEST
  HOST_REQUEST_REMINDER
  GUEST_CONFIRMED
  GUEST_REJECTED
  GUEST_EXPIRED
  GUEST_CANCELLED
  HOST_CANCELLED_BY_GUEST
}

enum BookingEmailDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum BlockType {
  MANUAL_BLOCK
  BOOKING_HOLD
  /** Mirrored from an external calendar (Airbnb, Booking.com, …) by the iCal sync.
   * Owned by the feed that created it: a re-sync deletes and recreates only these,
   * so a host's own manual blocks are never touched by a remote calendar. */
  EXTERNAL_SYNC
}

enum CalendarFeedStatus {
  PENDING
  OK
  ERROR
}

enum ListingMediaType {
  IMAGE
  VIDEO
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ConversationKind {
  INQUIRY
  BOOKING
}

enum ConversationStatus {
  OPEN
  FROZEN
  CLOSED
}

enum ConversationParticipantRole {
  MEMBER
  SUPPORT
}

enum BookingTimelineEventType {
  REQUESTED
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_HOST
  CANCELLED_BY_ADMIN
  COMPLETED
}

enum DamageReportStatus {
  REPORTED
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum SafetyCaseType {
  REPORT
  CLAIM
}

enum SafetyCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_INFORMATION
  RESOLVED
  REJECTED
}

enum SafetyCasePriority {
  NORMAL
  URGENT
}

enum SafetyCaseTargetType {
  USER
  HOST
  LISTING
  BOOKING
  MESSAGE
}

enum ReviewDirection {
  GUEST_TO_HOST
  HOST_TO_GUEST
}

enum ReviewStatus {
  PENDING_ADMIN
  APPROVED
  REJECTED
  HIDDEN
}

enum ReviewRatingCategory {
  OVERALL
  ACCURACY
  CHECK_IN
  CLEANLINESS
  COMMUNICATION
  LOCATION
  VALUE
  HOUSE_RULES
}

enum ReviewReminderStage {
  INVITATION
  DAY_3
  DAY_7
  HOURS_48
  HOURS_24
  OTHER_PARTY_SUBMITTED
}

enum ClaimKind {
  EXPENSE
  DAMAGE
  REFUND
}

enum ClaimResponseStatus {
  AWAITING_ADMIN
  AWAITING_RECIPIENT
  ACCEPTED
  COUNTERED
  REJECTED
  ESCALATED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  CHAT_MESSAGE
  CASE_SUBMITTED
  CASE_UPDATED
  SUPPORT_MESSAGE
  REVIEW_INVITATION
  REVIEW_SUBMITTED
  REVIEW_PUBLISHED
  REVIEW_REJECTED
  SYSTEM
}

enum CommunicationChannel {
  EMAIL
  PUSH
}

enum MarketingAudience {
  GUEST
  HOST
}

enum MarketingPreferenceStatus {
  NOT_SUBSCRIBED
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
  SUPPRESSED
}

enum MarketingConsentAction {
  REQUESTED
  CONFIRMED
  WITHDRAWN
  SUPPRESSED
}

enum MarketingSuppressionReason {
  UNSUBSCRIBE
  COMPLAINT
  HARD_BOUNCE
  MANUAL
  PRIVACY_OBJECTION
}

enum MarketingTokenPurpose {
  CONFIRM_EMAIL
  UNSUBSCRIBE_EMAIL
}

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
}

enum MarketingDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id        String               @id @default(cuid())
  userId    String?
  name      String
  email     String
  category  String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ─── User & Profile ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  image         String?
  name          String
  role          UserRole  @default(USER)
  isHost        Boolean   @default(false)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  /// Language for system email. Set when the visitor picks a language in the
  /// switcher; null means English. Emails are sent by background jobs hours after
  /// the fact, where the request-scoped locale cookie no longer exists — so the
  /// choice has to live on the account, not in `getLocale()`.
  locale        String?
  /// Display currency for browsing, so the choice follows the account to another
  /// device. Purely presentational: prices are authored, charged and settled in the
  /// listing's official currency regardless of what this says. Null means the
  /// visitor has never chosen, and detection applies.
  displayCurrency String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile                 Profile?
  properties              Property[]
  listings                Listing[]
  bookings                Booking[]
  auditLogs               AuditLog[]
  accounts                Account[]
  sessions                Session[]
  suggestions             Suggestion[]              @relation("SuggestionHost")
  reviewedSuggestions     Suggestion[]              @relation("SuggestionReviewer")
  listingDrafts           ListingDraft[]
  listingReports          ListingReport[]           @relation("ListingReportReporter")
  reviewedListingReports  ListingReport[]           @relation("ListingReportReviewer")
  favorites               Favorite[]
  userConsents            UserConsent[]
  notifications           Notification[]
  pushTokens              PushToken[]
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]                 @relation("MessageSender")
  messageEmailDeliveries  MessageEmailDelivery[]    @relation("MessageEmailRecipient")
  bookingTimelineEvents   BookingTimelineEvent[]    @relation("BookingTimelineActor")
  damageReports           DamageReport[]            @relation("DamageReporter")
  startedConversations    Conversation[]            @relation("ConversationStarter")
  inquiryConversations    Conversation[]            @relation("ConversationInquiryGuest")
  submittedSafetyCases    SafetyCase[]              @relation("SafetyCaseReporter")
  reportedSafetyCases     SafetyCase[]              @relation("SafetyCaseReportedUser")
  assignedSafetyCases     SafetyCase[]              @relation("SafetyCaseAssignedAdmin")
  safetyCaseUpdates       SafetyCaseUpdate[]        @relation("SafetyCaseUpdateAuthor")
  authoredReviews         Review[]                  @relation("ReviewAuthor")
  receivedReviews         Review[]                  @relation("ReviewSubject")
  moderatedReviews        Review[]                  @relation("ReviewModerator")
  reviewInvitations       ReviewInvitation[]
  reviewAdminReads        ReviewAdminRead[]
  communicationPreference CommunicationPreference?
  marketingContact        MarketingContact?
  contactMessages         ContactMessage[]
  deletionTokens          AccountDeletionToken[]

  @@index([email])
  @@index([role])
}

/// Confirmation link for self-service account deletion. Deliberately separate from
/// `VerificationToken` (Auth.js): that table is consumed by the sign-in callback, so a
/// token stored there could be redeemed as a login. These are single-purpose and
/// short-lived — the only thing a leaked one can do is delete the account it belongs to.
model AccountDeletionToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expires   DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ─── Auth.js (Google + magic link) ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  bio             String?
  avatarUrl       String?
  hostBio         String?
  hostDisplayName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Property & Listing ─────────────────────────────────────────────────────────

/**
 * Admin-manageable property types (e.g. "Detached House", "Row House"). Used to be a
 * Prisma enum, but that required a code migration + deploy every time a new type was
 * needed. Now a table so admins can approve host-suggested types at runtime (see
 * Suggestion below). `value` keeps the old enum's UPPER_SNAKE_CASE codes so existing
 * data/URLs/filters didn't need to change.
 */
model PropertyType {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  /**
   * Curated Lucide icon key, editable by admins in Settings.
   */
  icon        String   @default("Building2")
  /**
   * Short guest-facing explanation shown when a property type is hovered or focused.
   */
  description String   @default("A distinct type of accommodation available for guests to book.")
  /**
   * false = not offered in pickers/filters going forward, but still valid for any
   * property already using it (e.g. a "this listing only" suggestion approval).
   */
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  properties Property[]

  @@index([isActive])
}

model Property {
  id                  String       @id @default(cuid())
  ownerId             String
  name                String
  propertyType        String
  propertyTypeInfo    PropertyType @relation(fields: [propertyType], references: [value])
  address             String
  city                String
  area                String?
  country             String
  postalCode          String?
  latitude            Float?
  longitude           Float?
  locationSource      String?
  geocodingProvider   String?
  geocodingPlaceId    String?
  geocodingConfidence Float?
  /**
   * The exact Street View angle a host picked for this property (compass heading in
   * degrees, camera pitch, and the specific panorama id) — saved so guests see the
   * same curated view the host confirmed, rather than Google's default direction for
   * whatever panorama happens to be nearest. Null until a host actually saves one;
   * the guest-facing page falls back to no Street View at all rather than guessing.
   */
  streetViewHeading   Float?
  streetViewPitch     Float?
  streetViewPanoId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id])
  listings Listing[]

  @@index([ownerId])
  @@index([city])
  @@index([propertyType])
}

model Listing {
  id             String        @id @default(cuid())
  propertyId     String
  hostId         String
  title          String
  slug           String        @unique
  description    String
  /** What the guest exclusively books. Kept separate from Property.propertyType:
   * a private room can be inside a house, apartment, villa, or hotel. */
  spaceType      ListingSpaceType @default(ENTIRE_PLACE)
  status         ListingStatus @default(DRAFT)
  maxGuests      Int
  bedrooms       Int
  bathrooms      Int
  beds           Int
  /**
   * Wall-clock house rules ("15:00"), not instants — a check-in time is whatever the
   * clock on the wall says when the guest arrives, so storing it as DateTime would
   * attach a timezone that has no meaning here and shifts under the server's. Null
   * means the host is flexible and will agree arrival with the guest.
   */
  checkInTime    String?
  checkOutTime   String?
  moderationNote String?
  /**
   * True whenever the live content was created/edited since an admin last looked at
   * it — drives the admin "Pending Review" queue independently of `status`, since
   * listings are published immediately rather than gated behind approval.
   */
  needsReview    Boolean       @default(false)
  approvedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /** OPEN keeps the traditional "available unless blocked" calendar. CLOSED means
   * only explicit availability windows can be booked. The default preserves every
   * listing created before selected-date hosting existed. */
  availabilityMode ListingAvailabilityMode @default(OPEN)

  /**
   * Time-decayed demand signal (views + heavily-weighted bookings) recomputed by a
   * scheduled job — see lib/services/popularity.service.ts. Denormalised onto the
   * listing so the home page can order by it with a plain indexed query instead of
   * aggregating the event tables on every request. 0 means "no signal yet", which is
   * what gates the public "Popular homes" section from appearing at all.
   */
  popularityScore     Float     @default(0)
  popularityUpdatedAt DateTime?

  /**
   * Secret path segment of this listing's public iCal export — /api/calendar/<token>.ics.
   * The token *is* the credential: anyone holding it can read the listing's booked and
   * blocked dates (dates only, never guest identity), which is exactly what Airbnb and
   * Booking.com need and no more. Null until the host first opens the export, so
   * listings that never sync expose no feed at all, and rotatable from the calendar
   * screen when a host wants to cut an old subscriber off.
   */
  calendarFeedToken   String?   @unique

  property           Property            @relation(fields: [propertyId], references: [id])
  host               User                @relation(fields: [hostId], references: [id])
  images             ListingImage[]
  rooms              ListingRoom[]
  amenities          ListingAmenity[]
  pricingRule        PricingRule?
  datePrices         ListingDatePrice[]
  availabilityBlocks AvailabilityBlock[]
  availabilityWindows ListingAvailabilityWindow[]
  calendarFeeds      ListingCalendarFeed[]
  bookings           Booking[]
  suggestions        Suggestion[]
  reports            ListingReport[]
  safetyCases        SafetyCase[]
  favorites          Favorite[]
  views              ListingView[]
  conversations      Conversation[]
  reviews            Review[]
  promotions         ListingPromotion[]

  @@index([hostId])
  @@index([status])
  @@index([slug])
  @@index([status, popularityScore])
}

enum ListingSpaceType {
  ENTIRE_PLACE
  PRIVATE_ROOM
  SHARED_ROOM
  HOTEL_ROOM
}

/**
 * One row per visitor per listing per day — the raw signal behind popularityScore.
 * Deduped by (listingId, visitorKey, viewedOn) so a guest refreshing a page twenty
 * times counts once, which is what keeps "popular" from meaning "was already on the
 * home page". `visitorKey` is a salted hash of IP + user agent, never the raw values,
 * so no identifying data is stored; rows older than the scoring window are pruned by
 * the recompute job.
 */
model ListingView {
  id         String   @id @default(cuid())
  listingId  String
  visitorKey String
  viewedOn   DateTime @db.Date
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, visitorKey, viewedOn])
  @@index([listingId, viewedOn])
  @@index([viewedOn])
}

/**
 * A new listing's form state, autosaved on field blur before it satisfies the strict
 * validation a real Listing/Property row requires (title length, required fields,
 * etc.) — so it can hold partial/incomplete data without needing those columns to be
 * nullable. Submitting for review validates this data in full, creates the real
 * Property/Listing/PricingRule rows from it, and deletes this row. Never surfaced
 * publicly — purely a host-side "resume where I left off" mechanism.
 */
model ListingDraft {
  id        String   @id @default(cuid())
  hostId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

model ListingImage {
  id           String           @id @default(cuid())
  listingId    String
  url          String
  mediaType    ListingMediaType @default(IMAGE)
  alt          String?
  /** Listing-level sequence: the order a guest sees in the gallery, and the order the
   *  editor's All photos view shows. Independent of `roomOrder`. */
  displayOrder Int              @default(0)
  isPrimary    Boolean          @default(false)
  /** The space this photo belongs to, or null for Other / Unassigned. Photos are never
   *  required to have one — a host uploads first and organises later — and deleting a
   *  room nulls this rather than taking the photos down with it. */
  roomId       String?
  /** Sequence within `room`, kept apart from `displayOrder` so reordering a room's
   *  photo tour cannot silently rewrite the listing's gallery order. */
  roomOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  listing Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  room    ListingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([roomId])
}

// ─── Rooms and spaces ───────────────────────────────────────────────────────────

/**
 * A group of room types ("Interior", "Outdoor"), owned by admins rather than by code so
 * the taxonomy can grow from Settings without a deploy — the same arrangement
 * AmenityCategory has, and reconciled onto production by the same kind of release
 * snapshot.
 */
model RoomTypeCategory {
  id        String   @id @default(cuid())
  /** Stable slug used by the release snapshot and by `rooms.categories.<key>`. */
  key       String   @unique
  /** English label, and the source text every translation is measured against. */
  name      String   @unique
  icon      String?
  /** Admin-defined display order, ascending, in every room picker. */
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  roomTypes    RoomType[]
  translations RoomTypeCategoryTranslation[]

  @@index([isActive])
}

/** One kind of space a property can have — "Bedroom", "Terrace", "Sauna". */
model RoomType {
  id         String  @id @default(cuid())
  name       String  @unique
  /** Stable slug: survives renames, and matches `rooms.types.<key>` in the UI string
   *  catalog so a catalog row and its reviewed translation stay linked. */
  key        String  @unique
  categoryId String
  icon       String?
  sortOrder  Int     @default(0)
  /**
   * Whether one property can hold several of these. A repeatable type numbers its
   * instances ("Bedroom 1", "Bedroom 2"); a singular one stays unnumbered, because
   * "Kitchen 1" reads as a mistake on a property that only has the one.
   */
  isRepeatable Boolean  @default(true)
  /**
   * Offered up front in a listing's rooms rail before the host has created anything, as
   * a greyed row holding a zero. It becomes a real ListingRoom the moment a photo lands
   * on it — which is what saves a host from facing an empty rail and having to invent
   * the vocabulary of their own flat.
   */
  isStandard   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  category     RoomTypeCategory @relation(fields: [categoryId], references: [id])
  rooms        ListingRoom[]
  translations RoomTypeTranslation[]

  @@index([isActive])
  @@index([categoryId])
}

/** Admin-authored room type label per language, resolved ahead of the reviewed source
 *  catalog — same resolution order, and same reasoning, as AmenityTranslation. */
model RoomTypeTranslation {
  id         String @id @default(cuid())
  roomTypeId String
  locale     String
  label      String
  /** Typed by an admin rather than filled by the AI pass, so a re-fill leaves it. */
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([roomTypeId, locale])
  @@index([locale])
}

model RoomTypeCategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String
  label      String
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  category RoomTypeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language         @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

/**
 * One space inside one listing — the "Bedroom 2" a host drags photos onto.
 *
 * The structured type stays in `roomTypeId` so a room can be grouped, translated and
 * counted whatever the host calls it; `displayName` is an optional override ("Master
 * bedroom") that never becomes the only way to tell what kind of room this is.
 */
model ListingRoom {
  id          String   @id @default(cuid())
  listingId   String
  roomTypeId  String
  /** 1-based position among this listing's rooms of the same type, and what the "2" in
   *  "Bedroom 2" comes from. Always 1 for a type that is not repeatable. */
  ordinal     Int      @default(1)
  displayName String?
  /** Host-defined order of the photo tour, ascending. */
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing  Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomType RoomType       @relation(fields: [roomTypeId], references: [id])
  images   ListingImage[]

  /** One "Bedroom 2" per listing. Also what lets the first-open seeding insert with
   *  skipDuplicates instead of racing itself when two requests arrive together. */
  @@unique([listingId, roomTypeId, ordinal])
  @@index([listingId])
  @@index([roomTypeId])
}

// ─── Amenities ──────────────────────────────────────────────────────────────────

/**
 * A group of amenities ("Kitchen", "Safety"), owned by admins rather than by code so
 * a new group can be created, renamed, reordered and translated from Settings without
 * a deploy.
 */
model AmenityCategory {
  id   String @id @default(cuid())
  /** Stable slug used by the release snapshot and by `amenities.categories.<key>`. */
  key  String @unique
  /** English label, and the source text every translation is measured against. */
  name String @unique
  icon String?
  /** Admin-defined display order, ascending, for every amenity picker. */
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  amenities    Amenity[]
  translations AmenityCategoryTranslation[]

  @@index([isActive])
}

model Amenity {
  id         String @id @default(cuid())
  name       String @unique
  /** Stable slug: survives renames, and matches `amenities.items.<key>` in the UI
   *  string catalog so a catalog row and its reviewed translation stay linked. */
  key        String @unique
  categoryId String
  icon       String?
  /** Admin-defined display order within the category, ascending. */
  sortOrder  Int     @default(0)
  /**
   * false = not offered in the general amenity picker, but still valid for any
   * listing already using it (e.g. a "this listing only" suggestion approval).
   */
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category     AmenityCategory @relation(fields: [categoryId], references: [id])
  listings     ListingAmenity[]
  aliases      AmenityAlias[]
  translations AmenityTranslation[]

  @@index([isActive])
  @@index([categoryId])
}

/**
 * Admin-authored amenity label per language.
 *
 * Deliberately separate from UiTranslation: those keys come from the AST scan over
 * source literals, so a row an admin creates at runtime could never appear there.
 * Resolution order is this table, then the reviewed source-literal catalog in
 * lib/i18n/amenity-labels.ts, then the English name.
 */
model AmenityTranslation {
  id        String   @id @default(cuid())
  amenityId String
  locale    String
  label     String
  /** Typed by an admin rather than filled by the AI pass, so a re-fill leaves it. */
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([amenityId, locale])
  @@index([locale])
}

model AmenityCategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  label      String
  isManuallyEdited Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt

  category AmenityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language        @relation(fields: [locale], references: [code], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

/** Provider-specific labels that resolve to one canonical Linger Homes amenity. */
model AmenityAlias {
  id             String   @id @default(cuid())
  provider       String
  providerName   String
  normalizedName String
  amenityId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([provider, normalizedName])
  @@index([amenityId])
}

/**
 * Host-submitted "you're missing an option" requests for a property type or amenity
 * not in the current catalog. An admin can edit the label, then approve it either
 * GLOBAL (added to the catalog for all future listings) or LISTING_ONLY (usable just
 * on the listing that requested it, without polluting the catalog for everyone else).
 */
model Suggestion {
  id           String           @id @default(cuid())
  kind         SuggestionKind
  label        String
  note         String?
  status       SuggestionStatus @default(PENDING)
  scope        SuggestionScope?
  listingId    String?
  hostId       String
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime         @default(now())

  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  host       User     @relation("SuggestionHost", fields: [hostId], references: [id])
  reviewedBy User?    @relation("SuggestionReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([hostId])
}

/**
 * A visitor-submitted flag on a listing (e.g. "photos don't match", "price is wrong"),
 * with an optional free-text message. `reporterId` is nullable since reporting doesn't
 * require an account. An admin reviews it from /admin/reports and either dismisses it
 * or removes the listing (suspends it), mirroring Suggestion's review pattern.
 */
model ListingReport {
  id           String       @id @default(cuid())
  listingId    String
  reporterId   String?
  message      String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter   User?   @relation("ListingReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("ListingReportReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([listingId])
}

/**
 * A user saving a listing for later (the heart/"Save" toggle on cards and the listing
 * page). One row per user+listing so the saved state is the same everywhere it's shown
 * and survives across devices/sessions, and shows up in /account/favorites.
 */
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

// ─── Pricing ────────────────────────────────────────────────────────────────────

model PricingRule {
  id                String   @id @default(cuid())
  listingId         String   @unique
  baseNightlyRate   Decimal  @db.Decimal(14, 3)
  cleaningFee       Decimal  @default(0) @db.Decimal(14, 3)
  serviceFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  currency          String   @default("EUR")
  minNights         Int      @default(1)
  maxNights         Int      @default(365)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/**
 * A host-funded public offer. A listing may have several active offers. At quote
 * time, date-specific offers take precedence and the highest qualifying
 * minimum-night threshold wins.
 */
model ListingPromotion {
  id               String        @id @default(cuid())
  listingId        String
  type             PromotionType
  discountPercent  Int           @default(0)
  minimumNights    Int?
  freeCleaning     Boolean       @default(false)
  roundToWholeUnit Boolean       @default(true)
  startDate        DateTime?     @db.Date
  endDate          DateTime?     @db.Date
  disabledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([listingId, disabledAt])
  @@index([listingId, startDate, endDate])
}

model ListingDatePrice {
  id          String   @id @default(cuid())
  listingId   String
  date        DateTime @db.Date
  nightlyRate Decimal  @db.Decimal(14, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
}

// ─── Availability ───────────────────────────────────────────────────────────────

model AvailabilityBlock {
  id        String    @id @default(cuid())
  listingId String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  blockType BlockType
  bookingId String?
  /** Set only on EXTERNAL_SYNC rows — which imported calendar put this block here.
   * Cascades, so disconnecting a feed frees every date it was holding. */
  feedId    String?
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  feed    ListingCalendarFeed? @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
  @@index([bookingId])
  @@index([feedId])
}

/**
 * An external iCal calendar mirrored into this listing — the import half of channel
 * sync, the export half being Listing.calendarFeedToken.
 *
 * Deliberately one row per remote calendar rather than a single "airbnbUrl" column on
 * Listing: a host with the same place on Airbnb, Booking.com and Vrbo needs all three,
 * and each has to report its own freshness. `lastStatus` and `lastError` are kept so a
 * feed that has started failing (URL rotated, listing deleted upstream) is visible on
 * the calendar screen instead of silently going stale — the dates it already blocked
 * stay blocked until the host removes the feed, which is the safe direction to fail.
 */
model ListingCalendarFeed {
  id                String             @id @default(cuid())
  listingId         String
  /** Host-facing label ("Airbnb", "Booking.com"). Free text — the platform is not
   *  something we can reliably detect from an opaque .ics URL. */
  name              String
  url               String
  lastSyncedAt      DateTime?
  lastStatus        CalendarFeedStatus @default(PENDING)
  lastError         String?
  /** Counters from the last successful sync, shown to the host as proof it worked. */
  lastEventCount    Int                @default(0)
  lastBlockedNights Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  listing Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  blocks  AvailabilityBlock[]

  @@unique([listingId, url])
  @@index([listingId])
  @@index([lastSyncedAt])
}

/** Bookable windows for listings whose calendar is CLOSED by default. Stored with an
 * exclusive end date, matching bookings and AvailabilityBlock ranges. */
model ListingAvailabilityWindow {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

// ─── Booking ────────────────────────────────────────────────────────────────────

model Booking {
  id                    String         @id @default(cuid())
  reference             String         @unique @default(cuid())
  listingId             String
  guestId               String
  checkIn               DateTime       @db.Date
  checkOut              DateTime       @db.Date
  guestCount            Int
  currency              String         @default("EUR")
  nightlyRate           Decimal        @db.Decimal(14, 3)
  cleaningFee           Decimal        @default(0) @db.Decimal(14, 3)
  serviceFee            Decimal        @default(0) @db.Decimal(14, 3)
  totalPrice            Decimal        @db.Decimal(14, 3)
  originalTotal         Decimal?       @db.Decimal(14, 3)
  discountAmount        Decimal        @default(0) @db.Decimal(14, 3)
  promotionId           String?
  promotionType         PromotionType?
  priceBreakdown        Json?
  priceBreakdownVersion Int?
  /// What the guest was browsing in when they booked, plus the rate used to show it.
  /// Frozen at confirmation so the confirmation page and email keep showing the same
  /// approximate figure the guest saw, instead of silently re-converting at today's
  /// rate every time the page is opened. `currency` above remains the official,
  /// payable amount; these three are a record of a display, never of an obligation.
  /// Null when the guest was already browsing in the official currency.
  displayCurrency       String?
  displayRate           Decimal?       @db.Decimal(20, 10)
  displayTotal          Decimal?       @db.Decimal(14, 3)
  /// Language selected by the guest at booking time. Confirmation pages and
  /// transactional email use this snapshot, not a later account preference.
  guestLocale           String?
  numberOfNights        Int
  status                BookingStatus  @default(PENDING)
  responseDueAt         DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '24 hours')"))
  respondedAt           DateTime?
  hostReminderSentAt    DateTime?
  guestNote             String?
  hostNote              String?
  cancellationReason    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  listing            Listing                @relation(fields: [listingId], references: [id])
  guest              User                   @relation(fields: [guestId], references: [id])
  promotion          ListingPromotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  availabilityBlocks AvailabilityBlock[]
  conversation       Conversation?
  safetyCases        SafetyCase[]
  reviews            Review[]
  reviewInvitations  ReviewInvitation[]
  emailDeliveries    BookingEmailDelivery[]
  timelineEvents     BookingTimelineEvent[]
  damageReports      DamageReport[]

  @@index([listingId, status])
  @@index([guestId])
  @@index([status, responseDueAt])
  @@index([promotionId])
  @@index([listingId, checkIn, checkOut])
}

model BookingEmailDelivery {
  id          String                     @id @default(cuid())
  bookingId   String
  kind        BookingEmailKind
  status      BookingEmailDeliveryStatus @default(QUEUED)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([status, availableAt])
  @@index([bookingId, status])
}

// ─── Notifications & booking chat ─────────────────────────────────────────────

/**
 * Durable in-app notification. Push delivery is an additional transport for this
 * record, not the source of truth, so unread state survives across devices.
 */
model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  body            String
  route           String?
  data            Json?
  messageId       String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  pushAttempts    Int              @default(0)
  pushAvailableAt DateTime         @default(now())
  pushLockedAt    DateTime?
  pushSentAt      DateTime?
  pushLastError   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([userId, messageId])
  @@index([pushSentAt, pushAvailableAt])
}

/**
 * One device can rotate Expo push tokens over time. Tokens are unique globally and
 * reassigned to the currently authenticated user when a device changes account.
 */
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * The first release creates one conversation per booking. Keeping listingId explicit
 * makes future pre-booking inquiry conversations possible without changing Message.
 */
model Conversation {
  id                 String             @id @default(cuid())
  bookingId          String?            @unique
  listingId          String
  kind               ConversationKind   @default(BOOKING)
  status             ConversationStatus @default(OPEN)
  startedById        String?
  inquiryGuestId     String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  supportJoinedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  booking       Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing       Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startedBy     User?                     @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: SetNull)
  inquiryGuest  User?                     @relation("ConversationInquiryGuest", fields: [inquiryGuestId], references: [id], onDelete: SetNull)
  participants  ConversationParticipant[]
  messages      Message[]
  safetyCases   SafetyCase[]
  damageReports DamageReport[]

  @@unique([listingId, inquiryGuestId])
  @@index([listingId])
  @@index([kind, status])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           ConversationParticipantRole @default(MEMBER)
  unreadCount    Int                         @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime                    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id             String    @id @default(cuid())
  clientId       String?   @unique
  conversationId String
  senderId       String?
  body           String    @db.Text
  /// Locale chosen by the sender when this message was written. It lets the
  /// recipient see an honest "Google translated from …" disclosure when their
  /// reading language differs, without guessing from the text itself.
  sourceLocale   String    @default("en")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation    Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?                  @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  safetyCases     SafetyCase[]
  emailDeliveries MessageEmailDelivery[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageEmailDelivery {
  id          String                     @id @default(cuid())
  messageId   String
  recipientId String
  status      BookingEmailDeliveryStatus @default(QUEUED)
  attempts    Int                        @default(0)
  availableAt DateTime                   @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation("MessageEmailRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@index([status, availableAt])
  @@index([recipientId, status])
}

model BookingTimelineEvent {
  id             String                   @id @default(cuid())
  bookingId      String
  type           BookingTimelineEventType
  actorId        String?
  idempotencyKey String                   @unique
  data           Json?
  createdAt      DateTime                 @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}

model DamageReport {
  id             String             @id @default(cuid())
  bookingId      String
  conversationId String
  reporterId     String?
  description    String             @db.Text
  status         DamageReportStatus @default(REPORTED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  booking      Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User?                  @relation("DamageReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  evidence     DamageReportEvidence[]

  @@index([bookingId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model DamageReportEvidence {
  id             String   @id @default(cuid())
  damageReportId String
  url            String
  fileName       String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  damageReport DamageReport @relation(fields: [damageReportId], references: [id], onDelete: Cascade)

  @@index([damageReportId])
}

// ─── Safety reports & booking claims ──────────────────────────────────────────

model SafetyCase {
  id              String               @id @default(cuid())
  reference       String               @unique
  type            SafetyCaseType
  status          SafetyCaseStatus     @default(SUBMITTED)
  priority        SafetyCasePriority   @default(NORMAL)
  targetType      SafetyCaseTargetType
  category        String
  subject         String
  description     String               @db.Text
  reporterId      String
  reportedUserId  String?
  listingId       String?
  bookingId       String?
  messageId       String?
  conversationId  String?
  assignedAdminId String?
  resolution      String?              @db.Text
  claimKind       ClaimKind?
  requestedAmount Decimal?             @db.Decimal(10, 2)
  currency        String?
  responseStatus  ClaimResponseStatus?
  counterAmount   Decimal?             @db.Decimal(10, 2)
  responseNote    String?              @db.Text
  respondBy       DateTime?
  adminApprovedAt DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  reporter      User                 @relation("SafetyCaseReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser  User?                @relation("SafetyCaseReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  assignedAdmin User?                @relation("SafetyCaseAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  listing       Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  message       Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation  Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  evidence      SafetyCaseEvidence[]
  updates       SafetyCaseUpdate[]

  @@index([reporterId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedAdminId, status])
  @@index([listingId])
  @@index([bookingId])
  @@index([reportedUserId])
  @@index([responseStatus, respondBy])
}

model SafetyCaseEvidence {
  id        String   @id @default(cuid())
  caseId    String
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  safetyCase SafetyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model SafetyCaseUpdate {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String?
  body       String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  safetyCase SafetyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author     User?      @relation("SafetyCaseUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

// ─── Two-sided post-stay reviews ─────────────────────────────────────────────

model Review {
  id             String          @id @default(cuid())
  bookingId      String
  listingId      String
  authorId       String?
  subjectUserId  String?
  direction      ReviewDirection
  status         ReviewStatus    @default(PENDING_ADMIN)
  publicComment  String          @db.Text
  privateNote    String?         @db.Text
  submittedAt    DateTime        @default(now())
  reviewDeadline DateTime
  adminReadAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  rejectedAt     DateTime?
  moderationNote String?         @db.Text
  publishedAt    DateTime?
  hiddenAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing     Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author      User?             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subjectUser User?             @relation("ReviewSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  approvedBy  User?             @relation("ReviewModerator", fields: [approvedById], references: [id], onDelete: SetNull)
  ratings     ReviewRating[]
  adminReads  ReviewAdminRead[]

  @@unique([bookingId, direction])
  @@index([listingId, status, publishedAt])
  @@index([subjectUserId, status, publishedAt])
  @@index([status, submittedAt])
}

model ReviewRating {
  id       String               @id @default(cuid())
  reviewId String
  category ReviewRatingCategory
  score    Int

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@index([category, score])
}

model ReviewInvitation {
  id          String          @id @default(cuid())
  bookingId   String
  recipientId String
  direction   ReviewDirection
  deadline    DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  booking   Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient User                       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  reminders ReviewInvitationReminder[]

  @@unique([bookingId, direction])
  @@index([recipientId, deadline])
}

model ReviewInvitationReminder {
  id           String              @id @default(cuid())
  invitationId String
  stage        ReviewReminderStage
  sentAt       DateTime            @default(now())

  invitation ReviewInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, stage])
  @@index([sentAt])
}

model ReviewAdminRead {
  reviewId String
  adminId  String
  readAt   DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([reviewId, adminId])
  @@index([adminId, readAt])
}

// ─── Settings ───────────────────────────────────────────────────────────────────

model MarketplaceSettings {
  id                    String   @id
  featuredMarketEnabled Boolean  @default(false)
  featuredCity          String?
  featuredCountry       String?
  updatedAt             DateTime @updatedAt
}

model Language {
  code             String    @id // ISO 639-1, e.g. "mk", "en"
  name             String
  isDefault        Boolean   @default(false)
  isEnabled        Boolean   @default(true)
  sortOrder        Int       @default(0)
  /**
   * Whether this language's fixed UI text gets real AI translation, vs. relying
   * entirely on the Google Translate widget like every language does today.
   */
  useAiTranslation Boolean   @default(false)
  selectionCount   Int       @default(0)
  lastSelectedAt   DateTime?
  createdAt        DateTime  @default(now())

  translations                 UiTranslation[]
  amenityTranslations          AmenityTranslation[]
  amenityCategoryTranslations  AmenityCategoryTranslation[]
  roomTypeTranslations         RoomTypeTranslation[]
  roomTypeCategoryTranslations RoomTypeCategoryTranslation[]

  @@index([isEnabled])
}

/**
 * The master list of fixed UI strings found in the codebase by the extraction scan
 * (`scanUiStrings`). One row per `t()`/`<T>` key.
 */
model UiString {
  key        String   @id
  sourceText String
  filePath   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  translations UiTranslation[]

  @@index([isActive])
}

/**
 * AI-generated translation of a UiString for one locale. `sourceTextSnapshot` records
 * what the English text was at translation time, so we can detect drift when the
 * source text later changes without a re-sync.
 */
model UiTranslation {
  id                 String   @id @default(cuid())
  locale             String
  key                String
  value              String
  sourceTextSnapshot String
  isManuallyEdited   Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  language Language @relation(fields: [locale], references: [code], onDelete: Cascade)
  uiString UiString @relation(fields: [key], references: [key], onDelete: Cascade)

  @@unique([locale, key])
  @@index([locale])
}

/**
 * Single-row, cross-process lock guarding translation synchronization, so an
 * admin-triggered sync and a deployment sync can't run concurrently.
 * Deliberately a plain table rather than a Postgres advisory lock: the sync spans
 * minutes of external Anthropic calls, and Prisma pools connections. A
 * session-scoped advisory lock is bound to one connection and could be released on
 * a different pooled connection (leaking the lock), while a transaction-scoped lock
 * can't span the job at all without holding a transaction open across the API calls.
 * An owner token plus an expiry gives safe release (only the holder can release) and
 * crash recovery (a dead holder's lock frees itself once `expiresAt` passes).
 */
model TranslationSyncLock {
  id        String   @id
  owner     String
  startedAt DateTime @default(now())
  expiresAt DateTime
}

// ─── Audit ──────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}

// ─── Consent & Privacy ──────────────────────────────────────────────────────────

/**
 * Track user consent for cookies and data processing per GDPR.
 * If userId is null, it's an anonymous visitor's consent (identified by sessionId).
 */
model UserConsent {
  id             String   @id @default(cuid())
  userId         String?
  sessionId      String   @unique
  essential      Boolean  @default(true)
  analytics      Boolean  @default(false)
  marketing      Boolean  @default(false)
  consentVersion String   @default("1.0")
  ipAddress      String?
  userAgent      String?
  consentedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentedAt])
}

/**
 * User-controlled preferences for non-essential operational communications.
 * Essential account, security, payment, and active-booking messages are not
 * represented here because they cannot be disabled while the service is used.
 */
model CommunicationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  messageEmail    Boolean  @default(true)
  reviewEmail     Boolean  @default(true)
  operationalPush Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * A durable marketing identity. It is intentionally separate from User so
 * suppression records can survive account deletion and prevent re-import.
 */
model MarketingContact {
  id        String   @id @default(cuid())
  userId    String?  @unique
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  preferences  MarketingPreference[]
  suppressions MarketingSuppression[]
  deliveries   MarketingDelivery[]

  @@index([createdAt])
}

/**
 * Immutable wording shown when consent was requested. New wording requires a
 * new version so Linger Homes can prove exactly what a person accepted.
 */
model ConsentStatement {
  id            String               @id @default(cuid())
  version       String               @unique
  legalEntity   String
  senderName    String
  text          String               @db.Text
  channel       CommunicationChannel
  audience      MarketingAudience
  locale        String               @default("en")
  contentHash   String
  effectiveFrom DateTime             @default(now())
  retiredAt     DateTime?

  preferences MarketingPreference[]
  events      MarketingConsentEvent[]

  @@index([channel, audience, retiredAt])
}

model MarketingPreference {
  id          String                    @id @default(cuid())
  contactId   String
  channel     CommunicationChannel
  audience    MarketingAudience
  status      MarketingPreferenceStatus @default(NOT_SUBSCRIBED)
  statementId String?
  requestedAt DateTime?
  confirmedAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  contact    MarketingContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  statement  ConsentStatement?       @relation(fields: [statementId], references: [id], onDelete: SetNull)
  events     MarketingConsentEvent[]
  tokens     MarketingToken[]
  deliveries MarketingDelivery[]

  @@unique([contactId, channel, audience])
  @@index([status, channel, audience])
  @@index([statementId])
}

/**
 * Append-only consent evidence. metadata may contain a one-way request
 * fingerprint, user agent, referrer, and the UI source, but never a raw IP.
 */
model MarketingConsentEvent {
  id           String                 @id @default(cuid())
  preferenceId String
  statementId  String?
  action       MarketingConsentAction
  source       String
  metadata     Json?
  occurredAt   DateTime               @default(now())

  preference MarketingPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  statement  ConsentStatement?   @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([preferenceId, occurredAt])
  @@index([action, occurredAt])
}

model MarketingSuppression {
  id        String                     @id @default(cuid())
  contactId String
  channel   CommunicationChannel
  reason    MarketingSuppressionReason
  source    String
  createdAt DateTime                   @default(now())

  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel])
  @@index([reason, createdAt])
}

model MarketingToken {
  id           String                @id @default(cuid())
  preferenceId String
  purpose      MarketingTokenPurpose
  tokenHash    String                @unique
  expiresAt    DateTime?
  usedAt       DateTime?
  createdAt    DateTime              @default(now())

  preference MarketingPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@index([preferenceId, purpose])
  @@index([expiresAt])
}

model MarketingCampaign {
  id          String                  @id @default(cuid())
  name        String
  subject     String
  templateKey String
  audience    MarketingAudience
  channel     CommunicationChannel
  status      MarketingCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  deliveries MarketingDelivery[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model MarketingDelivery {
  id                String                  @id @default(cuid())
  campaignId        String
  contactId         String
  preferenceId      String?
  status            MarketingDeliveryStatus @default(QUEUED)
  providerMessageId String?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  campaign   MarketingCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    MarketingContact     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  preference MarketingPreference? @relation(fields: [preferenceId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([status, createdAt])
  @@index([contactId, createdAt])
}

// ─── Exchange rates ─────────────────────────────────────────────────────────────

/// The last successfully fetched rate table, stored as one row so display prices
/// survive a provider outage and a server restart. Rates are cached in memory for
/// normal traffic (see lib/currency/rates.ts); this row is the cold-start and
/// fallback source, not the read path for every request.
///
/// Always quoted against BASE_CURRENCY ("EUR"): `rates` is a JSON object of
/// `{ ISO4217: multiplier }` where multiplier converts one unit of base into that
/// currency. Display-only — nothing here ever feeds a stored or payable amount.
model ExchangeRateSnapshot {
  id        String   @id @default("current")
  base      String   @default("EUR")
  rates     Json
  provider  String
  /// When the provider says the rates themselves were published, which is what the
  /// "rate last updated" disclosure shows — not when this row was written.
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
