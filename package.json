{
  "name": "lingerhomes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run i18n:extract",
    "dev": "next dev",
    "prebuild": "npm run i18n:extract",
    "build": "next build",
    "start": "next start",
    "lint": "npm run i18n:check && eslint",
    "i18n:extract": "tsx scripts/extract-ui-strings.ts",
    "i18n:check": "tsx scripts/extract-ui-strings.ts --check",
    "i18n:sync": "node --conditions=react-server --import tsx scripts/sync-ui-translations.ts",
    "i18n:status": "node --conditions=react-server --import tsx scripts/ui-translation-status.ts",
    "i18n:review": "node --conditions=react-server --import tsx scripts/review-ui-translations.ts",
    "i18n:lookup": "node --conditions=react-server --import tsx scripts/lookup-ui-translations.ts",
    "i18n:audit": "node --conditions=react-server --import tsx scripts/audit-ui-translation-quality.ts",
    "i18n:normalize-serbian": "node --conditions=react-server --import tsx scripts/normalize-serbian-script.ts",
    "i18n:export-reviewed": "node --conditions=react-server --import tsx scripts/export-reviewed-ui-translations.ts",
    "i18n:import-reviewed": "node --conditions=react-server --import tsx scripts/import-reviewed-ui-translations.ts",
    "i18n:generate-reviewed": "node --conditions=react-server --import tsx scripts/generate-reviewed-ui-translations-gemini.ts",
    "i18n:generate-reviewed:openai": "node --conditions=react-server --import tsx scripts/generate-reviewed-ui-translations-openai.ts",
    "amenities:export": "node --conditions=react-server --import tsx scripts/export-amenity-catalog.ts",
    "amenities:import": "node --conditions=react-server --import tsx scripts/import-amenity-catalog.ts",
    "popularity:recompute": "node --conditions=react-server --import tsx scripts/recompute-popularity.ts",
    "reviews:reminders": "node --conditions=react-server --import tsx scripts/send-review-reminders.ts",
    "bookings:process": "node --conditions=react-server --import tsx scripts/process-booking-requests.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mobile:web": "npm --prefix mobile run web -- --port 8081",
    "mobile:preview": "npm --prefix mobile run build:web && npm --prefix mobile run preview",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android:debug": "npm --prefix mobile run android:debug",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:purge-users": "tsx prisma/purge-users-except-elena-admin.ts",
    "db:studio": "prisma studio",
    "db:docker": "docker compose up -d",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.2",
    "slugify": "^1.6.8",
    "sonner": "^2.0.7",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
